{
  "schema": 3,
  "required_executas": [
    {
      "tool_id": "tool-local-notes-summary-12345678",
      "min_version": "0.1.0",
      "version": "latest"
    }
  ],
  "permissions": ["storage.read", "storage.write"],
  "tags": ["notes", "productivity"],
  "ui": {
    "form_factors": ["desktop", "mobile"],
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "Mini Notes",
        "default": true,
        "entry": "index.html",
        "min_size": { "w": 360, "h": 480 },
        "default_size": { "w": 900, "h": 720 },
        "resizable": true,
        "single_instance": true
      }
    ],
    "host_api": {
      "storage": ["get", "set"],
      "tools": ["tool-local-notes-summary-12345678"],
      "llm": ["complete"]
    },
    "csp_overrides": { "script-src": ["'self'"], "style-src": ["'self'"] },
    "state_merge": "last_writer_wins"
  },
  "dev": { "seed_storage": {}, "user_id": 1 }
}
