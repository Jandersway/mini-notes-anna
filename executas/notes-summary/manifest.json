{
  "name": "tool-local-notes-summary-12345678",
  "display_name": "Mini Notes Summary",
  "version": "0.1.0",
  "description": "Summarize the supplied notes through host LLM sampling.",
  "host_capabilities": ["llm.sample"],
  "tools": [
    {
      "name": "summarize",
      "description": "Return a concise summary of the current notes, generated by host sampling.",
      "timeout": 60,
      "parameters": [
        {
          "name": "notes",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "order": { "type": "integer" },
              "content": { "type": "string" }
            },
            "required": ["content", "order"]
          },
          "required": true,
          "description": "Current notes in creation order."
        }
      ]
    }
  ],
  "runtime": {
    "type": "binary",
    "binary": {
      "entrypoint": {
        "default": "bin/notes-summary",
        "windows-x86_64": "bin/notes-summary.exe"
      },
      "permissions": { "bin/notes-summary": "0o755" }
    }
  }
}
